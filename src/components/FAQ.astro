---
import {faqItems} from "../data/site.ts";
---
<section class="border-t border-slate-200 bg-slate-50">
    <div class="mx-auto max-w-4xl px-4 py-16">
        <p class="section-label text-xl">Pytania i odpowiedzi</p>
        <h2 class="mb-8 text-2xl font-bold text-slate-900 md:text-3xl">
            Najczęstsze pytania przy sprzedaży mieszkania
        </h2>

        <div class="space-y-4">
            {faqItems.map((item: { question: unknown; answer: unknown; }) => (
                    <details class="group card-light p-4">
                        <summary class="flex list-none cursor-pointer items-center justify-between gap-4">
                            <span class="text-sm font-semibold text-slate-900">
                                {item.question}
                            </span>
                            <span
                                    aria-hidden="true"
                                    class="shrink-0 text-slate-400 transition-transform group-open:rotate-180"
                            >
                            ▾
                            </span>
                        </summary>

                        <p class="mt-3 text-sm leading-6 text-slate-700">
                            {item.answer}
                        </p>
                    </details>
            ))}
        </div>
    </div>
</section>