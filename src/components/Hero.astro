---
import {contact} from "../data/contact.ts";
import { Picture } from "astro:assets";
import heroLublin from "../images/stock-lublin-2.jpeg";
---

<section class="min-h-[80vh] flex items-center pt-0 pb-16">
    <div class="mx-auto flex max-w-5xl flex-col items-center px-4 py-16 text-center gap-10">
        <div class="max-w-3xl space-y-6 hero-fade-in-up">
            <p class="section-label mx-auto text-xl">
                SZYBKA, BEZPIECZNA SPRZEDAŻ
            </p>

            <h1 class="text-4xl font-semibold text-slate-50 sm:text-5xl">
                Gotówka za mieszkanie <span class="text-[#d3a842] text-[1.1em]">po spadku</span> lub z wadą
            </h1>

            <p class="mt-3 text-base text-slate-300 sm:text-lg">
                Bez remontu, bez stresu, pomagamy w formalnościach. Wycena w 24 godziny, decyzja i akt
                notarialny nawet w 7 dni.
            </p>

            <div class="mt-6 flex flex-wrap items-center justify-center gap-4">
                <a href="#kontakt" class="btn-outline hero-cta">
                    WYPEŁNIJ FORMULARZ
                </a>

                <a href={contact.phoneHref} class="btn-gold-main hero-cta">
                    ZADZWOŃ TERAZ
                </a>
            </div>
        </div>

        <!-- Zdjęcie pod hero -->
        <div class="mx-auto mt-10 max-w-5xl hero-fade-in-up-slow">
            <div class="overflow-hidden rounded-3xl bg-slate-900 shadow-[0_22px_60px_rgba(0,0,0,0.85)]">
                <Picture
                        src={heroLublin}
                        alt="Panorama Lublina"
                        widths={[640, 960, 1280, 1600]}
                        formats={["webp"]}
                        fallbackFormat="jpeg"
                        loading="eager"
                        fetchpriority="high"
                        class="block h-full w-full object-cover"
                />
            </div>
        </div>
    </div>
</section>