---
import Icon from "heroicons-astro/Heroicon.astro";
import { contact } from '../data/contact';
---

<header
        id="callbar"
        class="sticky top-0 z-40 border-b border-slate-800 bg-slate-900 transition-shadow supports-backdrop"
>
    <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-1.5 text-slate-200 sm:px-6 lg:px-8">
        <div class="space-y-0.5 text-xs leading-snug sm:text-sm">
            <p class="text-sm font-semibold sm:text-base">
                {contact.name}
            </p>
        </div>

        <a
                href={contact.phoneHref}
                class="btn-callbar"
        >
            <Icon
                    iconCode="phone"
                    iconStyle="outline"
                    customClasses="mr-3 h-5 w-5"
            />
            <span class="callbar-phone text-sm leading-none">
                {contact.phone}
            </span>
        </a>
    </div>
</header>

<script>
    const callbar = document.getElementById('callbar');

    const updateCallbarShadow = () => {
        if (!callbar) return;

        if (window.scrollY > 10) {
            callbar.classList.add('shadow-md', 'shadow-black/40');
        } else {
            callbar.classList.remove('shadow-md', 'shadow-black/40');
        }
    };

    updateCallbarShadow();
    window.addEventListener('scroll', updateCallbarShadow, { passive: true });
</script>